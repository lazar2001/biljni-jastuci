# Copy to .env.local and fill in. Never commit .env.local.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Verified sender, e.g. "Porudžbine <porudzbine@vasdomen.rs>"
ORDER_FROM_EMAIL=

# Where new orders and contact messages are delivered
ORDER_OWNER_EMAIL=

# Optional: Google Sheets (Apps Script) or Telegram bot webhook, receives every order as JSON
ORDER_WEBHOOK_URL=

# Development only: "1" enables demo prices (1.000 / 2.000 / 3.000 RSD, shipping 400,
# free above 5.000) so the order flow can be tested before real prices exist.
# Ignored in production builds. Without RESEND_API_KEY, dev emails are printed to the console.
NEXT_PUBLIC_DEMO_PRICES=

# Public site URL, used for metadata, sitemap and OG
NEXT_PUBLIC_SITE_URL=http://localhost:3000
